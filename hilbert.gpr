with "config/hilbert_config.gpr";
project Hilbert is

   for Source_Dirs use ("src/**", "config/");
   for Object_Dir use "obj/" & Hilbert_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("hilbert_cmd.adb");

   package Compiler is
      for Default_Switches ("Ada") use Hilbert_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Builder is
      for Executable ("hilbert_cmd") use "hilbert";
   end Builder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Hilbert;
